# Copy to .env for local development (.env is git-ignored). Never commit real values.
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=spendwise
DB_USER=spendwise
DB_PASSWORD=localpass
JWT_SECRET=type-any-long-random-text-here
AWS_REGION=ap-south-1
# S3_BUCKET is deliberately NOT set locally: receipts are saved to backend/uploads/ instead.
# On the server, a deploy script writes the real values (including S3_BUCKET) automatically.
